def sanitize_mermaid(code: str) -> str:
    """Corrige errores sintácticos comunes en Mermaid (ej: paréntesis sin comillas en subgraphs)."""
    lines = []
    for line in code.splitlines():
        m = re.match(r"^(\s*subgraph\s+)([^\"\[\n]+?\([^)\n]+?\)[^\"\[\n]*)$", line)
        if m:
            line = f'{m.group(1)}"{m.group(2).strip()}"'
        lines.append(line)
    return "\n".join(lines)


def process_alerts(html: str) -> str:
    """Convierte blockquotes con [!NOTE], [!TIP], etc., en alertas estilizadas de GitHub."""

    def replace_alert(match: re.Match) -> str:
        alert_type = match.group(1).upper()
        p1_content = match.group(2).strip()
        if p1_content.startswith("<br>"):
            p1_content = p1_content[4:].strip()
        elif p1_content.startswith("<br />"):
            p1_content = p1_content[6:].strip()

        extra_content = match.group(3).strip()
        body_parts = []
        if p1_content:
            body_parts.append(f"<p>{p1_content}</p>")
        if extra_content:
            body_parts.append(extra_content)

        full_body = "\n".join(body_parts)
        cfg = ALERT_CONFIG.get(alert_type, ALERT_CONFIG["NOTE"])

        return f"""<div class="markdown-alert markdown-alert-{alert_type.lower()}">
  <div class="markdown-alert-title">
    {cfg["icon"]}
    <span>{cfg["title"]}</span>
  </div>
  <div class="markdown-alert-content">
    {full_body}
  </div>
</div>"""

    pattern = re.compile(
        r"<blockquote>\s*<p>\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\](?:<br\s*/?>)?\s*(.*?)</p>(.*?)</blockquote>",
        re.DOTALL | re.IGNORECASE,
    )
    return pattern.sub(replace_alert, html)


def highlight_code(code: str, lang: str, _attrs: str) -> str:
    try:
        lexer = get_lexer_by_name(lang.strip()) if lang else TextLexer()
    except Exception:
        lexer = TextLexer()
    formatter = HtmlFormatter(nowrap=True, style="github-dark")
    return highlight(code, lexer, formatter)


def get_target_file(args: list[str]) -> Path:
    if len(args) > 1:
        raw_path = args[1]
        if raw_path.startswith("file://"):
            raw_path = raw_path[7:]
        path = Path(raw_path).expanduser().resolve()
        if not path.is_file():
            print(f"Error: El archivo '{path}' no existe.", file=sys.stderr)
            sys.exit(1)
        return path

    brain_dir = Path("/home/agustin/.gemini/antigravity-cli/brain")
    if brain_dir.is_dir():
        md_files = list(brain_dir.glob("*/*.md"))
        if md_files:
            md_files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
            return md_files[0]

    print("Uso: agy-preview [archivo.md | file://...]", file=sys.stderr)
    sys.exit(1)


def generate_html(md_path: Path) -> Path:
    content = md_path.read_text(encoding="utf-8", errors="replace")

    md = markdown_it.MarkdownIt("gfm-like", {"highlight": highlight_code, "html": True})

    default_fence = md.renderer.rules.get("fence")

    def custom_fence(tokens, idx, options, env):
        token = tokens[idx]
        info = token.info.strip().lower()
        if info == "mermaid":
            clean_mermaid = sanitize_mermaid(token.content)
            return f'<div class="mermaid">\n{clean_mermaid}\n</div>\n'
        if default_fence:
            return default_fence(tokens, idx, options, env)
        return f"<pre><code>{token.content}</code></pre>"

    md.renderer.rules["fence"] = custom_fence
    rendered_body = md.render(content)
    rendered_body = process_alerts(rendered_body)

    pygments_css = HtmlFormatter(style="github-dark").get_style_defs(".highlight")

