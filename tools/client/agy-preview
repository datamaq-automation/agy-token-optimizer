def main():
    target = get_target_file(sys.argv)
    html_path = generate_html(target)
    browser = "falkon"
    cmd = [browser, f"file://{html_path}"]
    try:
        subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as e:
        print(f"Error al abrir {browser}: {e}", file=sys.stderr)
        subprocess.Popen(["xdg-open", f"file://{html_path}"])


if __name__ == "__main__":
    main()
