{
  "global-post-edit-healer": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import sys, json; data = json.load(sys.stdin); print(json.dumps({}))'"
          }
        ]
      }
    ]
  }
}
